#lang reader SRFI-105

;; Scheme+ oracle : evaluates the curly-infix test expressions and prints
;;   id <TAB> value
;; one per line, for cross-checking against an independent Python oracle.

(module oracle_scheme racket

  (require Scheme+)

  (define (e id v) (display id) (display "\t") (display v) (newline))

  (define-syntax plus
    (syntax-rules ()
      ({var1 _ ...} {var1 + ...})))

  (define (fib n)
    (if {n < 2} n {(fib (n - 1)) + (fib (n - 2))}))
  (define (fact n)
    (if {n = 0} 1 {n * (fact {n - 1})}))
  (define (norm x y) {x ² + y ²})
  (define (linelen x0 y0 x1 y1) (√ {(x1 - x0) ² + (y1 - y0) ²}))
  (define (discriminant a b c) {b ² - 4 * a * c})

  (e "e01" {2 + 3 * 4})
  (e "e02" {3 * 5 + 2})
  (e "e03" {5 + 2})
  (e "e04" {3 * 7 + 2 - 12 / 3 + -2})
  (e "e05" {10 - 2 - 3})
  (e "e06" {100 / 10 / 5})
  (e "e07" {1 + 2 + 3 + 4 + 5})
  (e "e08" {2 * 3 * 4})
  (e "e09" {-5 + 3})
  (e "e10" {3 * -2})
  (e "e11" {2 ** 3})
  (e "e12" {2 * 2 ** 3})
  (e "e13" {3 ²})
  (e "e14" {4 ² + 3 ²})
  (e "e15" {3 · 5 + 2 ³})
  (e "e16" {3 ² + 2 · 3 · 5 + 5 ²})
  (e "e17" {1 / 2})
  (e "e18" {1 / 2 + 1 / 4})
  (e "e19" {17 % 5})
  (e "e20" {1 << 5})
  (e "e21" {40 >> 2})
  (e "e22" {3 * (2 + 4) - 1})
  (e "e23" {(3 + 1) * (2 + 4)})
  (e "e24" {((1 + 2) * 3) - (4 / (1 + 1))})
  (e "e25" {(10 - 2) / (1 + 1) + (2 * (3 + 1))})
  (e "e26" {2 ** (1 + 2)})
  (e "e27" {(2 + 3) ² - (1 + 1) ³})
  (e "e28" {3 * (- 9 4) + 2})
  (e "e29" {(- 7 (3 * (+ 2 4) - 1)) + 3})
  (e "e30" {(3 + 1) * (2 * (+ 2 1) - (sin 0.3)) + ((* 2 5) - 5)})
  (e "e31" {3 * (+ 2 4) - 1})
  (e "e32" (- (+ 3 3) {2 + 2}))
  (e "e33" {(max 3 7) + (min 10 2)})
  (e "e34" {(expt 2 3) + 1})
  (e "e35" {(apply + (list 1 2 3 4)) * 2})
  (e "e36" {(vector-ref (vector 10 20 30) 1) + 5})
  (e "e37" {(- 10 4) * 2})
  (e "e38" {(gcd 12 18) + (lcm 3 4)})
  (e "e39" (+ {2 * 3} {4 * 5}))
  (e "e40" {√ 16})
  (e "e41" (√ {9 + 16}))
  (e "e42" {{1 + 2} * {3 + 4}})
  (e "e43" {{10 / 2} + {2 ** 3}})
  (e "e44" {{{1 + 1} + {2 + 2}} * {3 + 4}})
  (e "e45" (fib 7))
  (e "e46" (fib 10))
  (e "e47" (fact 5))
  (e "e48" (norm 3 4))
  (e "e49" (linelen 0 0 3 4))
  (e "e50" (discriminant 1 -5 6))
  (e "e51" (discriminant 2 4 2))
  (e "e52" {2 plus 3})
  (e "e53" {2 plus 3 plus 4 plus 5 plus 6})
  (e "e54" {1 2 3 4 +})
  (e "e55" {5 !})
  (e "e56" {4 ²})
  (e "e57" {2 ³})
  (e "e58" {(2 + 3) !})
  (e "e59" {(1 + 1) 3 4 +})
  (e "e60" { {2 + 3} ² })
  (e "e61" {3 < 5})
  (e "e62" {2 + 2 = 4})
  (e "e63" {3 <> 4})
  (e "e64" {3 ≠ 3})
  (e "e65" {{2 < 3} and {4 < 5}})
  (e "e66" {{2 < 3} and {5 < 4}})
  (e "e67" (map (lambda (n) {n * n}) (list 1 2 3 4)))

  ) ; end module
